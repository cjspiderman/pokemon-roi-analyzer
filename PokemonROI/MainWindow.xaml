<Window x:Class="PokemonROI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pokémon ROI Analyzer" Width="1400" Height="850" MinWidth="1100" MinHeight="650" Background="#10141C" Foreground="#F3F5F7" FontFamily="Segoe UI">
 <Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#273449"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="#202938"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGrid"><Setter Property="Background" Value="#18202D"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#18202D"/><Setter Property="AlternatingRowBackground" Value="#202938"/><Setter Property="GridLinesVisibility" Value="None"/></Style></Window.Resources>
 <DockPanel><Border DockPanel.Dock="Top" Background="#18202D" Padding="18"><DockPanel><TextBlock Text="Pokémon ROI Analyzer" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Width="300" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel></DockPanel></Border>
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="WORKSPACE" Foreground="#8EA4C2" Margin="8,8"/><Button Content="Dashboard"/><Button Content="Cards"/><Button Content="Portfolio"/><Button Content="ROI Calculator"/><Button Content="Price History"/><Button Content="Watchlist"/><Button Content="Settings"/><TextBlock Text="Data &amp; projections are informational only. No investment recommendations." TextWrapping="Wrap" Foreground="#8EA4C2" Margin="10,30,10,0"/></StackPanel>
 <TabControl Grid.Column="1" Background="#10141C"><TabItem Header="Dashboard"><ScrollViewer><StackPanel Margin="16"><TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/><UniformGrid Columns="4" Margin="0,18"><Border Background="#202938" Padding="16" Margin="5"><StackPanel><TextBlock Text="Invested" Foreground="#9AAAC0"/><TextBlock Text="{Binding TotalInvested,StringFormat=C}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Background="#202938" Padding="16" Margin="5"><StackPanel><TextBlock Text="Current value" Foreground="#9AAAC0"/><TextBlock Text="{Binding TotalValue,StringFormat=C}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Background="#202938" Padding="16" Margin="5"><StackPanel><TextBlock Text="Profit / loss" Foreground="#9AAAC0"/><TextBlock Text="{Binding Profit,StringFormat=C}" FontSize="24" FontWeight="Bold"/></StackPanel></Border><Border Background="#202938" Padding="16" Margin="5"><StackPanel><TextBlock Text="ROI" Foreground="#9AAAC0"/><TextBlock Text="{Binding Roi,StringFormat={}{0:0.##}%}" FontSize="24" FontWeight="Bold"/></StackPanel></Border></UniformGrid><TextBlock Text="Scenario projection (8% annual growth)" Foreground="#9AAAC0"/><TextBlock Text="{Binding Projection5,StringFormat=5-year value: {0:C}}" FontSize="20" Margin="0,5,0,20"/><TextBlock Text="Status" Foreground="#9AAAC0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="Card Search"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Set" Binding="{Binding SetName}" Width="180"/><DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="90"/><DataGridTextColumn Header="Rarity" Binding="{Binding Rarity}" Width="160"/><DataGridTextColumn Header="Market price" Binding="{Binding MarketPrice,StringFormat=C}" Width="120"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180"/><DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt}" Width="180"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="Add selected card to portfolio" HorizontalAlignment="Left" Command="{Binding AddCommand}"/></Grid></TabItem>
 <TabItem Header="Portfolio"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Portfolio}" SelectedItem="{Binding SelectedPortfolio}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="Card" Binding="{Binding CardName}" Width="200"/><DataGridTextColumn Header="Set" Binding="{Binding SetName}" Width="180"/><DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="90"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Purchase" Binding="{Binding PurchasePrice,StringFormat=C}" Width="100"/><DataGridTextColumn Header="Current" Binding="{Binding CurrentPrice,StringFormat=C}" Width="100"/><DataGridTextColumn Header="Value" Binding="{Binding CurrentValue,StringFormat=C}" Width="110"/><DataGridTextColumn Header="Profit" Binding="{Binding Profit,StringFormat=C}" Width="110"/><DataGridTextColumn Header="ROI" Binding="{Binding Roi,StringFormat={}{0:0.##}%}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="Delete selected" Command="{Binding DeleteCommand}"/><Button Content="Export CSV" Command="{Binding ExportCommand}"/></StackPanel></Grid></TabItem></TabControl></Grid></DockPanel></Window>
